# Python: the render tools in tools/ leave these behind when imported.
__pycache__/
*.pyc

# Audio originals. `tools/compress-audio.py` keeps the supplied uncompressed
# set here so the conversion can be re-run at other settings; it is 4.8 MB of
# raw material the build never uses, and the compressed cues in
# `Assets/audio/sfx/` are what ship.
Assets/audio/masters/
